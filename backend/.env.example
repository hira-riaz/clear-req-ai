GEMINI_API_KEY=
GROQ_API_KEY=
 # Model names live here so a provider deprecation is an env change, not a code change
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# Leave empty locally (uses SQLite). In production: your Postgres URL
DATABASE_URL=
# Comma-separated. Not needed when FastAPI serves the frontend itself.
ALLOWED_ORIGINS=
# Per-user cap on requirement analyses per day (protects the shared free-tier AI quota)
DAILY_ANALYZE_LIMIT=40
